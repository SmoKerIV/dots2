#!/usr/bin/env bash

set -euo pipefail

repo_url="https://github.com/ManofJELLO/HyprWindowShade.git"
repo_commit="40b756befa36cfd5cbed65d554c719141a65c420"
source_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprwindowshade/$repo_commit"
patch_file="$HOME/.config/hypr/patches/hyprwindowshade-per-window-effects.patch"

command -v git >/dev/null || { printf '%s\n' 'error: git is required' >&2; exit 1; }
command -v g++ >/dev/null || { printf '%s\n' 'error: g++ is required' >&2; exit 1; }
command -v pkg-config >/dev/null || { printf '%s\n' 'error: pkg-config is required' >&2; exit 1; }

# Arch's hyprland package installs matching headers and hyprland.pc, so the
# compositor ABI is always the installed one. hyprpm's header cache is only a
# fallback for distributions that do not ship them.
if pkg-config --exists hyprland; then
    mapfile -t header_flags < <(pkg-config --cflags-only-I hyprland pixman-1 libdrm pangocairo | tr ' ' '\n' | sed '/^$/d')
elif [[ -d "/var/cache/hyprpm/$USER/headersRoot/include" ]]; then
    headers="/var/cache/hyprpm/$USER/headersRoot"
    header_flags=(
        -I"$headers/include"
        -I"$headers/include/hyprland"
        -I"$headers/include/hyprland/src"
        -I"$headers/include/hyprland/protocols"
        -I/usr/include/cairo
        -I/usr/include/freetype2
        -I/usr/include/libpng16
        -I/usr/include/pixman-1
        -I/usr/include/libdrm
    )
else
    printf '%s\n' 'error: Hyprland headers are unavailable (install the hyprland package or run hyprpm update)' >&2
    exit 1
fi

if [[ ! -d "$source_dir/.git" ]]; then
    mkdir -p "${source_dir%/*}"
    git clone --filter=blob:none "$repo_url" "$source_dir"
fi

git -C "$source_dir" fetch --quiet --depth=1 origin "$repo_commit"
git -C "$source_dir" checkout --quiet --detach "$repo_commit"
git -C "$source_dir" reset --quiet --hard "$repo_commit"
git -C "$source_dir" apply "$patch_file"

plugin_dir="$HOME/.local/share/hyprland/plugins"
plugin_path="$plugin_dir/HyprWindowShade.so"
mkdir -p "$plugin_dir"
(
    cd "$source_dir"
    g++ -shared -fPIC -O3 -std=c++23 *.cpp -o HyprWindowShade.so \
        "${header_flags[@]}" \
        -lGLESv2 -lEGL -lGL
    install -m 0755 HyprWindowShade.so "$plugin_path"
)
printf '%s\n' "Installed $plugin_path for the next Hyprland session; the running compositor was not touched."
