#!/usr/bin/env bash
set -euo pipefail

# One-shot Orbit setup for a fresh CachyOS (Arch) Hyprland install.
#
# usage: install-cachyos [--optional] [--reset-noctalia-state] [--yes]
#                        [--skip-packages] [--skip-plugins] [--skip-wallpaper]
#
# Order: packages -> takeover (backup + deploy) -> plugins and cursor theme
#        -> Wallpaper Engine -> verify. Every step is idempotent and can be
#        rerun on its own; see docs/install.md.
#
# It never changes the display manager (SDDM stays), monitor layout
# (run nwg-displays), or Plymouth (bin/install-plymouth-theme is separate).

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

optional=false
reset_state=false
assume_yes=false
skip_packages=false
skip_plugins=false
skip_wallpaper=false
for argument in "$@"; do
    case "$argument" in
        --optional) optional=true ;;
        --reset-noctalia-state) reset_state=true ;;
        --yes) assume_yes=true ;;
        --skip-packages) skip_packages=true ;;
        --skip-plugins) skip_plugins=true ;;
        --skip-wallpaper) skip_wallpaper=true ;;
        -h|--help) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'usage: %s [--optional] [--reset-noctalia-state] [--yes] [--skip-packages] [--skip-plugins] [--skip-wallpaper]\n' "$0" >&2; exit 2 ;;
    esac
done

step() { printf '\n==> %s\n' "$*"; }

if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-} ${ID_LIKE:-}" in
        *arch*|*cachyos*) ;;
        *) printf 'warning: %s is not CachyOS/Arch; package names may differ\n' "${PRETTY_NAME:-unknown}" >&2 ;;
    esac
fi

if [[ "$skip_packages" == false ]]; then
    step "Installing packages"
    package_groups=(--core --build --aur)
    [[ "$optional" == true ]] && package_groups+=(--optional)
    "$repo_dir/bootstrap/install-packages" "${package_groups[@]}"
fi

step "Replacing the existing Hyprland/Noctalia configuration with Orbit"
takeover_arguments=()
[[ "$optional" == true ]] && takeover_arguments+=(--optional)
[[ "$reset_state" == true ]] && takeover_arguments+=(--reset-noctalia-state)
[[ "$assume_yes" == true ]] && takeover_arguments+=(--yes)
"$repo_dir/bootstrap/takeover" "${takeover_arguments[@]}"

if [[ "$skip_plugins" == false ]]; then
    step "Building the pinned Hyprland plugins against the installed Hyprland"
    "$repo_dir/bin/install-hyprglass"
    "$repo_dir/bin/install-scrolloverview"
    "$repo_dir/bin/install-hyprwindowshade"
    "$repo_dir/bin/install-dynamic-cursors"
    step "Installing the Oblique cursor theme"
    "$repo_dir/bin/install-oblique-cursor"
fi

if [[ "$skip_wallpaper" == false ]]; then
    step "Installing the Orbit Wallpaper Engine integration"
    ORBIT_WALLPAPER_REPO_URL="${ORBIT_WALLPAPER_REPO_URL:-https://github.com/CleanShirtUK/orbit-wallpaper-engine.git}" \
        "$repo_dir/bin/dotfiles-install-wallpaper" ||
        printf 'warning: Wallpaper Engine integration failed; rerun bin/dotfiles-install-wallpaper later\n' >&2
fi

step "Verifying"
"$repo_dir/bootstrap/verify"

cat <<'EOF'

Orbit is deployed. Next:
  1. Log out and pick the "Hyprland" session (not the UWSM one) in SDDM.
  2. Run `nwg-displays` once to write ~/.config/hypr/monitors.lua.
  3. Optional: bin/install-plymouth-theme, bin/configure-zen, bin/configure-obsidian,
     bin/install-actions-for-nautilus, bin/configure-localsend-firewall.
Keybinds: docs/keybinds.md
EOF
