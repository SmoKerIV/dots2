[Unit]
Description=LocalSend background file-sharing service
PartOf=hyprland-session.target
After=hyprland-session.target

[Service]
# Native CachyOS/AUR package; the launcher helper falls back to the Flatpak.
ExecStart=%h/.local/bin/show-localsend --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=hyprland-session.target
