#!/usr/bin/env bash

set -euo pipefail

readonly app_id='com.dec05eba.gpu_screen_recorder'
readonly flathub_url='https://dl.flathub.org/repo/flathub.flatpakrepo'

# Arch/CachyOS: native package from [extra]. The Flatpak path is only used when
# pacman is unavailable or --flatpak is requested.
if [[ "${1:-}" != "--flatpak" ]] && command -v pacman >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm gpu-screen-recorder
    gpu-screen-recorder --help >/dev/null 2>&1 || true
    gsr-cli --help >/dev/null 2>&1 || true
    printf 'GPU Screen Recorder is installed from the native package.\n'
    printf 'Optional: sudo pacman -S gpu-screen-recorder-ui gpu-screen-recorder-notification\n'
    exit 0
fi

command -v flatpak >/dev/null 2>&1 || {
    printf 'Flatpak is required but was not found.\n' >&2
    exit 1
}

if ! flatpak remotes --system --columns=name | grep -qx 'flathub'; then
    sudo flatpak remote-add --if-not-exists --system flathub "$flathub_url"
fi

sudo flatpak install --system --assumeyes flathub "$app_id"

flatpak run --command=gpu-screen-recorder "$app_id" --help >/dev/null
flatpak run --command=gsr-cli "$app_id" --help >/dev/null

printf 'GPU Screen Recorder is installed and its command-line tools are available.\n'
