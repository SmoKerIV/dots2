#!/usr/bin/env bash
set -euo pipefail

# One-shot Orbit setup for a fresh CachyOS (Arch) Hyprland install.
#
# usage: install-cachyos [--optional] [--reset-noctalia-state] [--yes]
#                        [--skip-packages] [--skip-plugins] [--skip-wallpaper]
#
# Order: packages -> takeover (backup + deploy) -> plugins and cursor theme
#        -> Wallpaper Engine -> verify. Every step is idempotent and can be
#        rerun on its own; see docs/install.md.
#
# It never changes the display manager (SDDM stays), monitor layout
# (run nwg-displays), or Plymouth (bin/install-plymouth-theme is separate).

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

optional=false
reset_state=false
assume_yes=false
skip_packages=false
skip_plugins=false
skip_wallpaper=false
for argument in "$@"; do
    case "$argument" in
        --optional) optional=true ;;
        --reset-noctalia-state) reset_state=true ;;
        --yes) assume_yes=true ;;
        --skip-packages) skip_packages=true ;;
        --skip-plugins) skip_plugins=true ;;
        --skip-wallpaper) skip_wallpaper=true ;;
        -h|--help) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) printf 'usage: %s [--optional] [--reset-noctalia-state] [--yes] [--skip-packages] [--skip-plugins] [--skip-wallpaper]\n' "$0" >&2; exit 2 ;;
    esac
done

step() { printf '\n==> %s\n' "$*"; }

# Deploy creates symlinks that point into this checkout, so it must live
# somewhere permanent. A ZIP unpacked into Downloads is the usual mistake.
case "$repo_dir" in
    "${HOME}/Downloads"/*|/tmp/*|/var/tmp/*|"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/*)
        cat >&2 <<EOF
This checkout is in a temporary location: $repo_dir
Orbit is deployed as symlinks into it, so move it somewhere permanent first:
  mv "$repo_dir" ~/orbit-dotfiles && cd ~/orbit-dotfiles && ./bootstrap/install-cachyos $*
(or clone it: git clone https://github.com/SmoKerIV/dots2.git ~/orbit-dotfiles)
EOF
        exit 1
        ;;
esac
if [[ ! -d "$repo_dir/.git" ]]; then
    printf 'note: %s is not a git checkout; you will not be able to `git pull` updates.\n' "$repo_dir" >&2
fi

if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case "${ID:-} ${ID_LIKE:-}" in
        *arch*|*cachyos*) ;;
        *) printf 'warning: %s is not CachyOS/Arch; package names may differ\n' "${PRETTY_NAME:-unknown}" >&2 ;;
    esac
fi

if [[ "$skip_packages" == false ]]; then
    step "Installing packages"
    package_groups=(--core --build)
    [[ "$optional" == true ]] && package_groups+=(--optional)
    "$repo_dir/bootstrap/install-packages" "${package_groups[@]}"
    # AUR builds can fail for reasons unrelated to Orbit; they only affect the
    # Qt theme provider and icon theme, so do not let them block the takeover.
    "$repo_dir/bootstrap/install-packages" --aur ||
        printf 'warning: AUR packages failed; rerun later with: %s --aur\n' "$repo_dir/bootstrap/install-packages" >&2
fi

step "Replacing the existing Hyprland/Noctalia configuration with Orbit"
takeover_arguments=()
[[ "$optional" == true ]] && takeover_arguments+=(--optional)
[[ "$reset_state" == true ]] && takeover_arguments+=(--reset-noctalia-state)
[[ "$assume_yes" == true ]] && takeover_arguments+=(--yes)
"$repo_dir/bootstrap/takeover" "${takeover_arguments[@]}"

# From here on the configuration is deployed; a failed build must not hide the
# final instructions, so failures are collected instead of aborting.
failed=()
attempt() {
    local label="$1"
    shift
    if ! "$@"; then
        failed+=("$label")
        printf 'warning: %s failed; rerun it later with: %s\n' "$label" "$*" >&2
    fi
}

if [[ "$skip_plugins" == false ]]; then
    step "Building the pinned Hyprland plugins against the installed Hyprland"
    attempt "Hyprglass" "$repo_dir/bin/install-hyprglass"
    attempt "ScrollOverview" "$repo_dir/bin/install-scrolloverview"
    attempt "HyprWindowShade" "$repo_dir/bin/install-hyprwindowshade"
    attempt "Dynamic Cursors" "$repo_dir/bin/install-dynamic-cursors"
    step "Installing the Oblique cursor theme"
    attempt "Oblique cursor" "$repo_dir/bin/install-oblique-cursor"
fi

if [[ "$skip_wallpaper" == false ]]; then
    step "Installing the Orbit Wallpaper Engine integration"
    attempt "Wallpaper Engine" "$repo_dir/bin/dotfiles-install-wallpaper"
fi

step "Verifying"
attempt "verify" "$repo_dir/bootstrap/verify"

if (( ${#failed[@]} > 0 )); then
    printf '\nSteps that need attention: %s\n' "${failed[*]}"
fi

cat <<'EOF'

Orbit is deployed. The running session still shows the old shell; to see Orbit:
  1. Log out NOW (SUPER+ALT+C -> Log out, or `hyprctl dispatch exit`) and pick
     the "Hyprland" session in SDDM (not the UWSM one).
  2. After logging in, run `nwg-displays` once to write ~/.config/hypr/monitors.lua.
  3. Optional: bin/install-plymouth-theme, bin/configure-zen, bin/configure-obsidian,
     bin/install-actions-for-nautilus, bin/configure-localsend-firewall.
Keybinds: docs/keybinds.md
EOF

(( ${#failed[@]} == 0 ))
