# Restrained Orbit boot theme.
# The status line is event-driven: it only changes when Plymouth receives a
# native display-message or update-status event. It never reads boot logs.

Window.SetBackgroundTopColor(0.035, 0.039, 0.055);
Window.SetBackgroundBottomColor(0.020, 0.023, 0.035);

# logo.png is placed by install-plymouth-theme (CachyOS watermark by default).
title.image = Image("logo.png");
title.image = title.image.Scale(300, 300);
title.sprite = Sprite(title.image);
title.x = Window.GetX() + Window.GetWidth() / 2 - title.image.GetWidth() / 2;
title.y = Window.GetY() + Window.GetHeight() * 0.42 - title.image.GetHeight() / 2;
title.sprite.SetPosition(title.x, title.y, 10);

bar.count = 32;
bar.segment_width = 9;
for (index = 0; index < bar.count; index++)
  {
    bar.segment[index].image = Image.Text("=", 0.54, 0.71, 0.98);
    bar.segment[index].sprite = Sprite(bar.segment[index].image);
    bar.segment[index].x = Window.GetX() + Window.GetWidth() / 2
      - bar.count * bar.segment_width / 2 + index * bar.segment_width;
    bar.segment[index].y = Window.GetY() + Window.GetHeight() * 0.58;
    bar.segment[index].sprite.SetPosition(bar.segment[index].x, bar.segment[index].y, 10);
    bar.segment[index].sprite.SetOpacity(0.18);
  }

fun progress_callback (duration, fraction)
  {
    filled = Math.Int(fraction * bar.count);
    for (index = 0; index < bar.count; index++)
      {
        if (index < filled)
          bar.segment[index].sprite.SetOpacity(1);
        else
          bar.segment[index].sprite.SetOpacity(0.18);
      }
  }

Plymouth.SetBootProgressFunction(progress_callback);

status.sprite = Sprite();
status.text = "";

fun set_status (text)
  {
    status.text = text;
    status.image = Image.Text(text, 0.62, 0.65, 0.75);
    status.sprite.SetImage(status.image);
    status.x = Window.GetX() + Window.GetWidth() / 2 - status.image.GetWidth() / 2;
    status.y = Window.GetY() + Window.GetHeight() * 0.76;
    status.sprite.SetPosition(status.x, status.y, 10);
  }

fun update_status_callback (text)
  {
    set_status(text);
  }

fun display_message_callback (text)
  {
    set_status(text);
  }

fun hide_message_callback (text)
  {
    if (status.text == text)
      set_status("");
  }

Plymouth.SetUpdateStatusFunction(update_status_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
